# TransplantLink Configuration
# Synthetic Demonstration Prototype

PORT=8000
HOST=0.0.0.0
MCP_SERVER_SECRET=demo-secret-key

# Supabase Configuration (Optional for cloud Supabase PostgreSQL)
# If left empty, TransplantLink uses the built-in deterministic SQLite/JSON repository
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional LLM API Key for clinical reasoning synthesis (OpenAI, Anthropic, or Gemini)
# If empty, TransplantLink uses the built-in deterministic clinical explanation synthesizer
LLM_API_KEY=
OPENAI_API_KEY=
